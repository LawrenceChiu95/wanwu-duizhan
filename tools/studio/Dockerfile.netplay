FROM node:22-bookworm-slim AS download
COPY tools/studio/download-frp.mjs /download-frp.mjs
RUN node /download-frp.mjs && tar -xzf /tmp/frp.tar.gz -C /tmp

FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=download /tmp/frp_0.72.0_linux_amd64/frps /usr/local/bin/frps
COPY tools/netplay/package*.json ./tools/netplay/
RUN npm --prefix tools/netplay ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY tools/netplay/*.mjs ./tools/netplay/
COPY tools/studio/gateway.mjs tools/studio/start.mjs tools/studio/frps.toml ./tools/studio/
COPY sim/ ./sim/
COPY data/catalog.json ./data/catalog.json
COPY web/ ./web/
ENV WANWU_WEB_ROOT=/app/web WANWU_STUDIO_NETPLAY=1
EXPOSE 7860
CMD ["node", "tools/studio/start.mjs"]
